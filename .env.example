# Скопируйте этот файл в .env и заполните значения.
# Файл .env нельзя коммитить в git и публиковать.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# Строка подключения к БД.
# SQLite (по умолчанию): sqlite+aiosqlite:///data/pc_builder.db
# PostgreSQL (в будущем): postgresql+asyncpg://user:password@localhost:5432/pc_builder
DATABASE_URL=sqlite+aiosqlite:///data/pc_builder.db

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Защита от спама: не более THROTTLE_MAX_ACTIONS действий за THROTTLE_WINDOW секунд,
# после превышения пользователь блокируется на THROTTLE_COOLDOWN секунд
THROTTLE_MAX_ACTIONS=8
THROTTLE_WINDOW=5
THROTTLE_COOLDOWN=5

# --- Цены (необязательно) ---
# Цены берутся ТОЛЬКО из разрешённых источников: CSV, который загружает администратор, или JSON-фид.
# Формат фида: [{"category":"gpu","name":"<точное название из каталога>","shop":"Магазин","price":34999,"in_stock":true,"url":"https://..."}]
PRICE_FEED_URL=
PRICE_FEED_TOKEN=
# Название магазина по умолчанию, если в записях фида нет поля shop
PRICE_FEED_SHOP=
# Как часто обновлять цены из фида, часов (0 — не обновлять автоматически)
PRICE_REFRESH_HOURS=6
